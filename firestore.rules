rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidRankingEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'timestamp'])
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 50
        && data.score is number
        && data.timestamp is number;
    }

    match /sabelotodo_top50_ranking/{rankingId} {
      allow read: if true;
      allow create: if isValidRankingEntry(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
